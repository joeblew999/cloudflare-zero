.wrangler/
node_modules/
.dev.vars
.env*
.claude/worktrees/
dist/
# Cloudflare's cf CLI caches the account it logs into here: never commit it.
.cloudflare/
bin/
# A go build of the tool at the root: mise run tool:build writes bin/.
/mise-cloudflare
# Third-party repos cloned by mise run repos:check (repos.txt lists them).
/repos/
# Go test caches and editor files
*.test
*.out
.DS_Store
# mise's override for one machine: mise-check's own checkout pins its build there (local)
.mise/config.local.toml
